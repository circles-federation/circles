# Copy to .env.local (gitignored) and adjust as needed.

# Local Postgres — see docker-compose.yml. Server-only: never NEXT_PUBLIC_,
# since only lib/db/ and lib/better-auth.ts ever hold a DB connection.
DATABASE_URL=postgres://circles:circles@localhost:5432/circles

# Signs Better Auth's session cookies — generate a real secret per
# environment (e.g. `openssl rand -base64 32`); any placeholder is fine for
# local dev only.
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email (login codes, event notifications, digests) — see
# lib/email/index.ts. Locally this is Mailpit from docker-compose.yml: read the
# mail at http://localhost:8025. Production uses Resend's SMTP relay:
#   SMTP_URL=smtps://resend:re_your_api_key@smtp.resend.com:465
# ("resend" is the literal username; the password is the full API key from
# Resend's dashboard). EMAIL_FROM must be an address on a domain verified in
# Resend (its DNS instructions add the SPF/DKIM records) — Resend refuses to
# relay from an unverified one. Any other SMTP relay works too, since this is
# a change of SMTP_URL, not of code.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Circles <login@circles.local>"

# Web Push — see lib/push/index.ts. Generate a keypair per environment with
# `npx web-push generate-vapid-keys`; the public key is built into the browser
# code (NEXT_PUBLIC_), the private one must stay on the server. Changing the
# keys invalidates every device's subscription. VAPID_SUBJECT is a contact the
# push services can reach the operator at.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@circles.local

# When the daily events digest goes out — the hour (0-23) in the server's local
# time (set TZ if the server isn't in your community's timezone). Default 8.
DIGEST_HOUR=8

# Texts (lib/sms/): a Telnyx API key, the verified toll-free number texts are
# sent from (E.164, e.g. +18885550123), and Telnyx's public key for checking
# its webhooks (Mission Control → Keys & Credentials → Public Key). Leave them
# unset in development to log texts instead of sending them (texted codes are
# also shown on screen there).
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
