# Copy to .env.local (gitignored) and adjust as needed.

# Local Postgres — see docker-compose.yml. Server-only: never NEXT_PUBLIC_,
# since only lib/db/ and lib/better-auth.ts ever hold a DB connection.
DATABASE_URL=postgres://circles:circles@localhost:5432/circles

# Signs Better Auth's session cookies — generate a real secret per
# environment (e.g. `openssl rand -base64 32`); any placeholder is fine for
# local dev only.
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email (login codes now; notifications and digests later) — see
# lib/email/index.ts. Locally this is Mailpit from docker-compose.yml: read the
# mail at http://localhost:8025. In production point SMTP_URL at any SMTP relay
# or your own server (smtps://user:password@host:465) and set EMAIL_FROM to an
# address on a domain that relay is set up to send as.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Circles <login@circles.local>"

# When the daily events digest goes out — the hour (0-23) in the server's local
# time (set TZ if the server isn't in your community's timezone). Default 8.
DIGEST_HOUR=8
