{
  "name": "circles",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed:beta": "tsx --env-file=.env.local scripts/seed-beta.ts",
    "admin": "tsx --env-file=.env.local scripts/set-admin.ts",
    "convert-to-consent": "tsx --env-file=.env.local scripts/convert-to-consent.ts",
    "icons": "tsx scripts/generate-icons.tsx"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@heroicons/react": "^2.2.0",
    "@lezer/common": "1.5.4",
    "@lezer/markdown": "1.8.0",
    "@sentry/browser": "^11.11.0",
    "@sentry/node": "^11.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.16",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "marked": "18.1.0",
    "next": "16.4.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "railway": "^3.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
